-- ===== Hàm lấy targets =====
local function getTargets()
    local list = {}
    local myTeam = player.Team
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local head = plr.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and root then
                if AIMBOT.teamCheck and myTeam ~= nil and plr.Team == myTeam then
                    -- skip
                else
                    table.insert(list, {
                        plr = plr, char = plr.Character, hum = hum,
                        root = root, head = head,
                    })
                end
            end
        end
    end
    return list
end

local function isTargetValid(t)
    if not t then return false end
    if not t.plr or not t.plr.Parent then return false end
    if not t.char or not t.char.Parent then return false end
    if not t.hum or t.hum.Health <= 0 then return false end
    return true
end

-- ═══════════════════════════════════════════════════════════
-- 🎯 TÌM TARGET: Filter theo FOV pixel + chọn gần nhất theo studs
-- ═══════════════════════════════════════════════════════════
local function findClosestTarget()
    local targets = getTargets()
    if #targets == 0 then return nil end

    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local vpSize = camera.ViewportSize
    local center = Vector2.new(vpSize.X / 2, vpSize.Y / 2)
    local myPos = myRoot.Position
    local best, bestDist = nil, math.huge

    for _, t in ipairs(targets) do
        -- 1. Check FOV pixel (target phải nằm trong vòng tròn)
        local screenPos, onScreen = camera:WorldToViewportPoint(t.root.Position)
        if onScreen then
            local sp = Vector2.new(screenPos.X, screenPos.Y)
            local pixelDist = (sp - center).Magnitude

            if pixelDist <= AIMBOT.fov then
                -- 2. Check max distance (studs)
                local studDist = (t.root.Position - myPos).Magnitude
                if studDist <= AIMBOT.maxDistance and studDist < bestDist then
                    bestDist = studDist
                    best = t
                end
            end
        end
    end
    return best
end

local function getAimPosition(t)
    if not t then return nil end
    if t.head and t.head.Parent then
        return t.head.Position
    end
    return t.root.Position
end

