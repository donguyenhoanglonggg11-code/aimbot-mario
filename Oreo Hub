local function activateTab(tab)
    if not tab or activeTab == tab then return end
    if activeTab then
        TweenService:Create(activeTab.btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(140, 100, 72),
            BackgroundTransparency = 1,
        }):Play()
        TweenService:Create(activeTab.stroke, TweenInfo.new(0.2), { Transparency = 1 }):Play()
        TweenService:Create(activeTab.nameLbl, TweenInfo.new(0.2), { TextColor3 = C.TabTxt }):Play()
        activeTab.content.Visible = false
    end
    activeTab = tab
    TweenService:Create(tab.btn, TweenInfo.new(0.2), {
        BackgroundColor3 = C.TabActive, BackgroundTransparency = 0,
    }):Play()
    TweenService:Create(tab.stroke, TweenInfo.new(0.2), {
        Transparency = 0, Color = C.TabActiveB,
    }):Play()
    TweenService:Create(tab.nameLbl, TweenInfo.new(0.2), { TextColor3 = C.TextDark }):Play()
    tab.content.Visible = true
    panelTitle.Text = TRANSLATIONS[currentLang][tab.panelTitleKey]
    panelSubtitle.Text = TRANSLATIONS[currentLang][tab.panelSubKey]
end

