local function createSlider(parent, labelKey, default, minValue, maxValue, unit, order, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 46)
    row.BackgroundTransparency = 1
    row.LayoutOrder = order
    row.ZIndex = 7
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -90, 0, 18)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = TRANSLATIONS[currentLang][labelKey]
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 14
    lbl.TextColor3 = C.TextDark
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 8
    lbl.Parent = row
    addLangItem(lbl, labelKey)

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 90, 0, 18)
    valLbl.Position = UDim2.new(1, -90, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(default) .. (unit or "")
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 14
    valLbl.TextColor3 = C.Red
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.ZIndex = 8
    valLbl.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 14)
    track.Position = UDim2.new(0, 0, 0, 26)
    track.BackgroundColor3 = Color3.fromRGB(225, 215, 195)
    track.BorderSizePixel = 0
    track.ZIndex = 8
    track.Parent = row
    corner(track, 7)
    stroke(track, Color3.fromRGB(190, 175, 150), 1)

    local initialT = (default - minValue) / (maxValue - minValue)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initialT, 0, 1, 0)
    fill.BackgroundColor3 = C.TabActiveB
    fill.BorderSizePixel = 0
    fill.ZIndex = 9
    fill.Parent = track
    corner(fill, 7)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = UDim2.new(initialT, -11, 0.5, -11)
    knob.BackgroundColor3 = C.TabActiveB
    knob.BorderSizePixel = 0
    knob.ZIndex = 10
    knob.Parent = track
    corner(knob, 999)
    stroke(knob, Color3.fromRGB(190, 150, 30), 1.5)

    local value = default
    local dragging = false

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, 20, 0, 30)
    hit.Position = UDim2.new(0, -10, 0, 18)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.ZIndex = 11
    hit.Parent = row

    local function updateFromX(mx)
        local pos = track.AbsolutePosition.X
        local w = track.AbsoluteSize.X
        local t = math.clamp((mx - pos) / w, 0, 1)
        value = math.floor((minValue + t * (maxValue - minValue)) * 10 + 0.5) / 10
        valLbl.Text = tostring(value) .. (unit or "")
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, -11, 0.5, -11)
        if callback then callback(value) end
    end

    hit.MouseButton1Down:Connect(function()
        dragging = true
        updateFromX(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)

    return row, function() return value end
end

