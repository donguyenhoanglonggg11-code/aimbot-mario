local function makeMarioCloud(scale)
    local c = Instance.new("Frame")
    c.BackgroundTransparency = 1
    c.Size = UDim2.new(0, 56 * scale, 0, 22 * scale)
    c.ZIndex = 10
    c.Parent = cloudHolder
    local function puff(px, py, s)
        local p = Instance.new("Frame")
        p.Size = UDim2.new(0, s * scale, 0, s * scale)
        p.Position = UDim2.new(0, px * scale, 0, py * scale)
        p.BackgroundColor3 = C.Cloud
        p.BorderSizePixel = 0
        p.ZIndex = 10
        p.Parent = c
        corner(p, 999)
    end
    puff(0, 6, 16); puff(14, 0, 22); puff(34, 6, 16)
    return c
end

local clouds = {}
for i = 1, 5 do
    local scale = 0.5 + math.random() * 0.5
    local cl = makeMarioCloud(scale)
    local baseY = 4 + math.random(-2, 6)
    local baseX = math.random(0, MENU_W)
    cl.Position = UDim2.new(0, baseX, 0, baseY)
    table.insert(clouds, {
        obj = cl, speed = 10 + math.random() * 15,
        baseY = baseY, baseX = baseX,
        bobAmp = 1.5 + math.random() * 1.5,
        bobFreq = 0.5 + math.random() * 0.5,
        phase = math.random() * math.pi * 2,
    })
end
task.spawn(function()
    local t0 = tick()
    while cloudHolder.Parent do
        local elapsed = tick() - t0
        for _, cl in ipairs(clouds) do
            local newX = cl.baseX + cl.speed * elapsed
            local wrapW = MENU_W + 80
            newX = ((newX + 40) % wrapW) - 40
            local bobY = math.sin(elapsed * cl.bobFreq * math.pi * 2 + cl.phase) * cl.bobAmp
            cl.obj.Position = UDim2.new(0, newX, 0, cl.baseY + bobY)
        end
        task.wait()
    end
end)

