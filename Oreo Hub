-- 🎯 AIMBOT MAIN LOOP
-- ═══════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
    if not AIMBOT.enabled or not AIMBOT.isHolding then
        targetHighlight.Visible = false
        return
    end

    local t = AIMBOT.lockedTarget
    if not isTargetValid(t) then
        t = findClosestTarget()
        AIMBOT.lockedTarget = t
    end

    if not t then
        targetHighlight.Visible = false
        return
    end

    local aimPos = getAimPosition(t)
    if not aimPos then return end

    local camPos = camera.CFrame.Position
    local targetCF = CFrame.new(camPos, aimPos)

    if AIMBOT.smooth > 0 and AIMBOT.smooth < 1 then
        local alpha = 1 - AIMBOT.smooth
        camera.CFrame = camera.CFrame:Lerp(targetCF, math.clamp(alpha * 10 * dt * 60, 0, 1))
    else
        camera.CFrame = targetCF
    end

    -- Update highlight
    local screenPos = camera:WorldToViewportPoint(t.root.Position)
    if screenPos.Z > 0 then
        targetHighlight.Visible = true
        targetHighlight.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
        local hpPct = t.hum.Health / t.hum.MaxHealth
        hpFill.Size = UDim2.new(hpPct, 0, 1, 0)
        if hpPct > 0.6 then
            hpFill.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
        elseif hpPct > 0.3 then
            hpFill.BackgroundColor3 = Color3.fromRGB(240, 200, 60)
        else
            hpFill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        end
    else
        targetHighlight.Visible = false
    end
end)

