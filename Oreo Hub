local function corner(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = f
    return c
end
local function stroke(f, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
end
local function buildPixel(parent, pattern, palette, pixelSize, flip, zidx)
    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.ZIndex = zidx or 10
    container.Parent = parent
    local w = #pattern[1] * pixelSize
    local h = #pattern * pixelSize
    container.Size = UDim2.new(0, w, 0, h)
    for r = 1, #pattern do
        local line = pattern[r]
        if flip then line = string.reverse(line) end
        for c = 1, #line do
            local ch = line:sub(c, c)
            if palette[ch] then
                local px = Instance.new("Frame")
                px.Size = UDim2.new(0, pixelSize, 0, pixelSize)
                px.Position = UDim2.new(0, (c-1)*pixelSize, 0, (r-1)*pixelSize)
                px.BackgroundColor3 = palette[ch]
                px.BorderSizePixel = 0
                px.ZIndex = zidx or 10
                px.Parent = container
            end
        end
    end
    return container, w, h
end

