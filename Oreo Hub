-- 📷 CAMERA STABILIZATION v3 - KHÔNG LOCK POSITION
-- Chỉ reset CameraOffset + Neck.C0 + Waist.C0, không động vào position
-- ═══════════════════════════════════════════════════════════

local function resetCameraShake()
    local char = player.Character
    if not char then return end

    -- 1. Reset CameraOffset (nguồn số 1 gây shake)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.CameraOffset = Vector3.zero
    end

    -- 2. Reset Neck.C0 (nếu game lắc đầu)
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if torso then
        local neck = torso:FindFirstChild("Neck")
        if neck and neck:IsA("Motor6D") then
            if not neck:GetAttribute("OreoOrigC0") then
                neck:SetAttribute("OreoOrigC0", neck.C0)
            end
            local origC0 = neck:GetAttribute("OreoOrigC0")
            if typeof(origC0) == "CFrame" then
                neck.C0 = origC0
            end
        end

        -- 3. Reset Waist.C0
        local waist = torso:FindFirstChild("Waist")
        if waist and waist:IsA("Motor6D") then
            if not waist:GetAttribute("OreoOrigC0") then
                waist:SetAttribute("OreoOrigC0", waist.C0)
            end
            local origC0 = waist:GetAttribute("OreoOrigC0")
            if typeof(origC0) == "CFrame" then
                waist.C0 = origC0
            end
        end
    end
end

